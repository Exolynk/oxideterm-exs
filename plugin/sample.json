  "source": "// preview\nconst MAX = 10;\ntype Money { cents: Int }\nfn total(items: List) -> Int | Error {\n    let sum = 0;\n    for item in items { sum = sum + item.cents; }\n    log::info(f\"sum: {sum}\");\n    ret Color::Red;\n}\n",
